# Random 32+ char string. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Comma-separated emails that can open /admin (platform owner dashboard)
ADMIN_EMAILS=charanjit@thecharanjitsingh.com

# Trial days are counted in this timezone (trial locks at 00:00 on day 15)
APP_TIMEZONE=Asia/Kolkata

# Public URL of the site (used for invite links and Stripe redirects)
APP_URL=https://saasmodels.tech

# Database: defaults to a local SQLite file (file:local.db). For production use Turso/libSQL:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
# (TURSO_DATABASE_URL / TURSO_AUTH_TOKEN, as set by the Vercel Marketplace integration, also work.)

# Email (invites, password resets, leave notifications) via https://resend.com.
# Without a key, emails are only logged and invite links must be copied by hand.
RESEND_API_KEY=
EMAIL_FROM="saasmodels.tech <no-reply@saasmodels.tech>"

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token). Random 16+ chars.
CRON_SECRET=

# Encrypts stored integration secrets (webhook URLs, Razorpay keys). 32+ random chars; never change it once set.
# Falls back to SESSION_SECRET when empty.
ENCRYPTION_KEY=

# Ask AI. Any OpenAI-compatible API works; the default is Google Gemini (free tier key from https://aistudio.google.com).
# Without a key, Ask AI still answers common questions in "rules" mode.
AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash
# AI_DAILY_LIMIT=200

# Sign in with Google / Microsoft (optional; buttons only appear when set).
# Redirect URIs: <APP_URL>/api/auth/google/callback and <APP_URL>/api/auth/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Stripe (https://dashboard.stripe.com/apikeys). Create 2 products with a monthly + yearly
# per-seat recurring price each, then paste the price IDs below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
