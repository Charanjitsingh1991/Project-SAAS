# Random 32+ char string. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Comma-separated emails that can open /admin (platform owner dashboard)
ADMIN_EMAILS=charanjit@thecharanjitsingh.com

# Trial days are counted in this timezone (trial locks at 00:00 on day 15)
APP_TIMEZONE=Asia/Kolkata

# Public URL of the site (used for invite links and Stripe redirects)
APP_URL=https://saasmodels.tech

# Database: defaults to a local SQLite file (file:local.db). For production use Turso/libSQL:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Stripe (https://dashboard.stripe.com/apikeys). Create 2 products with a monthly + yearly
# per-seat recurring price each, then paste the price IDs below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
