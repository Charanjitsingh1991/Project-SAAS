# Random 32+ char string. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Comma-separated emails that can open /admin (platform owner dashboard)
ADMIN_EMAILS=charanjit@thecharanjitsingh.com

# Trial days are counted in this timezone (trial locks at 00:00 on day 15)
APP_TIMEZONE=Asia/Kolkata

# Public URL of the site (used for invite links and Stripe redirects)
APP_URL=https://saasmodels.tech

# Database: defaults to a local SQLite file (file:local.db). For production use Turso (see docs/DEPLOY.md).
# The Vercel × Turso integration's TURSO_DATABASE_URL / TURSO_AUTH_TOKEN names also work.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Protects /api/cron/daily (Vercel sends it automatically as a Bearer token)
CRON_SECRET=

# Email via Resend (https://resend.com). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="saasmodels.tech <no-reply@saasmodels.tech>"

# Optional "Continue with Google" (OAuth client, redirect URI: $APP_URL/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (https://dashboard.stripe.com/apikeys). Create 2 products with a monthly + yearly
# per-seat recurring price each, then paste the price IDs below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
